+/// Kernel birth identity captured while the source still owns the unreaped child.
+#[derive(Debug, Clone, Copy)]
+pub struct LocalProcessIdentity {
+    pub pid: u32,
+    pub start_ticks: u64,
+}
+
+impl LocalProcessIdentity {
+    pub fn read(pid: u32) -> Option<Self> {
+        #[cfg(target_os = "linux")]
+        {
+            let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+            let (_, fields) = stat.rsplit_once(") ")?;
+            let start_ticks = fields.split_whitespace().nth(19)?.parse().ok()?;
+            Some(Self { pid, start_ticks })
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            let _ = pid;
+            None
+        }
+    }
+}
