+//! Receipts emitted at real local spawn/exit boundaries, not from model or command text.
+
+use std::sync::{
+    Arc,
+    atomic::{AtomicU32, AtomicU64, Ordering},
+};
+
+use async_channel::Sender;
+use codex_protocol::protocol::{Event, EventMsg, ExecutionAttemptEvent, ExecutionAttemptPhase};
+
+static NEXT_EXECUTION: AtomicU32 = AtomicU32::new(0);
+
+/// Source session lifetime and emission order, independent of physical process ordinals.
+pub(crate) struct ExecutionContext {
+    id: String,
+    sequence: AtomicU64,
+}
+
+impl ExecutionContext {
+    pub(crate) fn new() -> Self {
+        Self {
+            id: uuid::Uuid::now_v7().to_string(),
+            sequence: AtomicU64::new(0),
+        }
+    }
+
+    fn next_sequence(&self) -> Option<u64> {
+        self.sequence
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+                value.checked_add(1)
+            })
+            .ok()?
+            .checked_add(1)
+    }
+}
+
+#[derive(Clone)]
+pub(crate) struct ExecutionSink {
+    context: Arc<ExecutionContext>,
+    event: ExecutionAttemptEvent,
+    sender: Sender<Event>,
+}
+
+pub(crate) struct ExecutionRecorder {
+    context: Arc<ExecutionContext>,
+    event: ExecutionAttemptEvent,
+    sender: Sender<Event>,
+}
+
+impl ExecutionSink {
+    pub(crate) fn new(
+        thread_id: String,
+        context: Arc<ExecutionContext>,
+        turn_id: String,
+        call_id: String,
+        origin: &str,
+        working_directory: Option<String>,
+        sender: Sender<Event>,
+    ) -> Self {
+        Self {
+            event: ExecutionAttemptEvent {
+                receipt_version: 2,
+                thread_id,
+                execution_context_id: context.id.clone(),
+                lane_sequence: 0,
+                working_directory,
+                turn_id,
+                call_id,
+                origin: origin.to_owned(),
+                execution_ordinal: 0,
+                phase: ExecutionAttemptPhase::Started,
+                process_pid: None,
+                process_start_ticks: None,
+                exit_code: None,
+            },
+            context,
+            sender,
+        }
+    }
+
+    /// Call only after a local process was successfully created.
+    pub(crate) async fn started(
+        mut self,
+        identity: Option<codex_utils_pty::LocalProcessIdentity>,
+    ) -> Option<ExecutionRecorder> {
+        let ordinal = NEXT_EXECUTION
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+                value.checked_add(1)
+            })
+            .ok()?
+            .checked_add(1)?;
+        self.event.execution_ordinal = ordinal;
+        self.event.process_pid = identity.map(|value| value.pid);
+        self.event.process_start_ticks = identity.map(|value| value.start_ticks);
+        self.event.lane_sequence = self.context.next_sequence()?;
+        let event = Event {
+            id: self.event.turn_id.clone(),
+            msg: EventMsg::ExecutionAttempt(self.event.clone()),
+        };
+        self.sender.send(event).await.ok()?;
+        Some(ExecutionRecorder {
+            context: self.context,
+            event: self.event,
+            sender: self.sender,
+        })
+    }
+}
+
+impl ExecutionRecorder {
+    /// Missing exit measurements produce no invented terminal receipt.
+    pub(crate) async fn exited(mut self, exit_code: Option<i32>) {
+        let Some(exit_code) = exit_code.filter(|code| *code >= 0) else {
+            return;
+        };
+        let Some(sequence) = self.context.next_sequence() else {
+            return;
+        };
+        self.event.lane_sequence = sequence;
+        self.event.phase = ExecutionAttemptPhase::Exited;
+        self.event.exit_code = Some(exit_code);
+        let event = Event {
+            id: self.event.turn_id.clone(),
+            msg: EventMsg::ExecutionAttempt(self.event),
+        };
+        let _ = self.sender.send(event).await;
+    }
+}
